# Database (Neon / Vercel Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/marketing?sslmode=require

# AWS SES
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_SES_REGION=eu-west-2

# Webhook auth (shared secret with cloud.sessiontalk.co.uk)
WEBHOOK_SECRET=your-webhook-secret-here

# App
NEXT_PUBLIC_APP_URL=https://marketing.sessiontalk.co.uk

# Optional: SES configuration set for newsletter sends (open/click/bounce event publishing).
# Unset (default) = newsletter sends go out exactly as before: no ConfigurationSetName and no SES tags.
# When set, every newsletter send passes ConfigurationSetName plus tags contact_id / campaign / variant.
# Expected value when enabled: marketing-newsletter (the IAM send policy must allow that configuration-set ARN).
# SES_CONFIGURATION_SET=marketing-newsletter

# SessionCloud base URL used by the nurture worker to mint {{verify_url}} at send time
# (POST /api/v1/marketing/confirm-email-url, signed with WEBHOOK_SECRET). Optional;
# defaults to https://cloud.sessiontalk.io. Do not put CONFIRM_EMAIL_SECRET here —
# that secret stays on SessionCloud only.
# SESSIONCLOUD_API_URL=https://cloud.sessiontalk.io
